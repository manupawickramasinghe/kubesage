# KubeSage environment. Copy:  cp .env.example .env   then load:  set -a; . ./.env; set +a
# .env is gitignored (mode 600 recommended). NEVER commit a real key — this repo may be public.
# With NO key set at all, everything runs in deterministic mock mode: full pipeline, $0, no network calls.

# ── Pick ONE provider (or none) ─────────────────────────────────────────────
# Option 1 (verified, cheapest): Cerebras. Get a key at https://cloud.cerebras.ai
# Then run with:  KUBESAGE_MODELS=cerebras kubesage serve
CEREBRAS_API_KEY=

# Option 2: Meta Model API (default profile, config/models.yaml).
# NOTE: some model IDs/prices in that profile are marked UNVERIFIED in the file — check before use.
MODEL_API_KEY=

# Option 3: any other OpenAI-compatible endpoint (OpenAI, Together, a local vLLM, …).
# No new variable needed: copy config/models.cerebras.yaml to config/models.<name>.yaml,
# edit base_url / model / prices / api_key_env there, add that env var below, and run
# with KUBESAGE_MODELS=<name>. See docs/getting-started.md.

# Which profile to load: blank = config/models.yaml (Meta). "cerebras" = config/models.cerebras.yaml.
KUBESAGE_MODELS=

# ── Where your metrics and timezone live ────────────────────────────────────
# Prometheus or VictoriaMetrics base URL. Default is the docker-compose stack in this repo.
KUBESAGE_VM_URL=http://localhost:8428
# YOUR timezone — daily peaks, working hours and cron schedules are computed in it.
# The default in code is Asia/Colombo; set this to where your workloads' users are.
KUBESAGE_TZ=Asia/Colombo

# ── Optional ────────────────────────────────────────────────────────────────
# Alternative config directory (models/skus/calendar YAMLs). Default: ./config
# KUBESAGE_CONFIG_DIR=
# Path to kubeconfig for apply/serve. Default: .bin/kubeconfig (created by scripts/cluster-up.sh).
# KUBECONFIG=
# Executor agent's own git identity (deploy key OUTSIDE the repo; see docs/agents.md).
# The private key must never be placed inside this repository.
# KUBESAGE_EXECUTOR_SSH_KEY=/home/you/.ssh/kubesage-executor
# GitHub CLI token, only if the Executor opens PRs without an interactive `gh auth login`.
# GH_TOKEN=
# docker compose: set BIND_ADDR=0.0.0.0 to reach Grafana/VictoriaMetrics from another machine.
BIND_ADDR=127.0.0.1
GRAFANA_ADMIN_PASSWORD=admin
# Alertmanager for the agent team. Default: http://localhost:9193
# KUBESAGE_ALERTMANAGER_URL=
