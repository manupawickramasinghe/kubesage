# Copy to .env and load with: set -a; source .env; set +a
# Meta Model API key. Without it, `kubesage analyze` runs in mock mode.
MODEL_API_KEY=
KUBESAGE_VM_URL=http://localhost:8428
KUBESAGE_TZ=Asia/Colombo
# docker compose: set to 0.0.0.0 to reach Grafana/VictoriaMetrics from another machine (e.g. over Tailscale)
BIND_ADDR=127.0.0.1
GRAFANA_ADMIN_PASSWORD=admin
